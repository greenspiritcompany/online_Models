{
    "name": "telltale/models",
    "version": "1.0.13",
    "description": "Models that match our data structure",
    "type": "package",
    "license": "proprietary",
    "authors": [
        {
            "name": "jwagstaff",
            "email": "jwagstaff@telltalegames.com"
        }
    ],
    "require": {
        "psr/cache": "@stable",
        "php": ">=7",
        "league/oauth2-client": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "@stable",
        "phpmd/phpmd": "@stable"
    },
    "autoload": {
        "psr-4": {
            "Telltale\\DataMapper\\": "src/DataMapper",
            "Telltale\\Model\\": "src/Model"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Telltale\\DataMapper\\Tests\\": "tests",
            "Telltale\\Model\\Tests\\": "tests"
        }
    }
}